# =======================================================
# Copy this file to `.env` and fill in real values.
# Never commit the real .env to git.
# =======================================================

# --- Django ---
# Generate a new one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-secret-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Local: leave blank to use SQLite (db.sqlite3 in project root)
# Railway: Railway auto-injects DATABASE_URL when you attach Postgres
DATABASE_URL=

# --- Google Calendar (OAuth) ---
# Setup steps live in DEPLOY.md. You generate the refresh token ONCE locally,
# then paste it here and into Railway env vars.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Email of the Google account that owns the calendar (your friend's company account)
GOOGLE_CALENDAR_OWNER_EMAIL=
# Optional: ID from the Drive folder URL where confirmed shoot folders should live.
# Leave blank to create them in this account's My Drive.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Auto-create and share a Drive folder when a videographer accepts a shoot.
# Currently disabled. Set to true to turn it back on.
GOOGLE_DRIVE_CREATE_FOLDERS_ON_ACCEPT=false

# --- Pipedrive ---
# Used to verify incoming webhooks are really from Pipedrive (shoot/edit automation)
PIPEDRIVE_WEBHOOK_SECRET=
# Required to CREATE Facebook leads in Pipedrive. Personal Preferences -> API
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# Optional: Pipedrive user id that should own new Facebook leads
PIPEDRIVE_LEAD_OWNER_ID=
# Optional: Pipedrive lead-label UUID to tag Facebook leads
PIPEDRIVE_FACEBOOK_LABEL_ID=

# --- Local Game Opportunities research ---
# Shared only between local publisher and Railway. Never commit its value.
OPPORTUNITIES_SYNC_SECRET=
# Optional compatible Python for public GameSheet requests only (local example: /usr/bin/python3).
OPPORTUNITIES_PUBLIC_PYTHON=
# Optional Chromium executable for the isolated Muse research browser.
OPPORTUNITIES_BROWSER_EXECUTABLE=
RAILWAY_SYNC_URL=https://web-production-09290.up.railway.app

# --- Facebook Instant Forms ---
# Random string you invent; paste the same value into Meta's webhook Verify Token
FACEBOOK_VERIFY_TOKEN=
# App secret from Meta app Settings -> Basic (used to check X-Hub-Signature-256)
FACEBOOK_APP_SECRET=
# Long-lived Page access token (prefer a Business Manager system user token)
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: ignore leadgen events from any other Page
FACEBOOK_PAGE_ID=
# Pin Graph API version. Default v22.0
FACEBOOK_GRAPH_API_VERSION=v22.0

# --- ClickUp (edit jobs) ---
# Required for real ClickUp task creation. If blank, local/dev uses a fake ClickUp client.
CLICKUP_API_TOKEN=

# --- Scheduling behavior ---
# How long to wait for a videographer to accept before escalating (hours)
ESCALATION_HOURS=24
# Scoring penalty: rating points deducted per minute of drive time
# Example: 0.01 means a 30-min drive penalizes 0.30 rating points
SCORE_PENALTY_PER_MINUTE=0.01
# Hard cap: skip any videographer further than this (minutes)
MAX_DRIVE_MINUTES=180

# --- Notifications (where to alert your friend) ---
NOTIFY_EMAIL=
