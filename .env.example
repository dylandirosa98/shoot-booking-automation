# =======================================================
# Copy this file to `.env` and fill in real values.
# Never commit the real .env to git.
# =======================================================

# --- Django ---
# Generate a new one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-secret-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Local: leave blank to use SQLite (db.sqlite3 in project root)
# Railway: Railway auto-injects DATABASE_URL when you attach Postgres
DATABASE_URL=

# --- Google Calendar (OAuth) ---
# Setup steps live in DEPLOY.md. You generate the refresh token ONCE locally,
# then paste it here and into Railway env vars.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Email of the Google account that owns the calendar (your friend's company account)
GOOGLE_CALENDAR_OWNER_EMAIL=

# --- Pipedrive ---
# Used to verify incoming webhooks are really from Pipedrive
PIPEDRIVE_WEBHOOK_SECRET=
# Required for edit jobs when webhook payloads do not include the full activity note
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# --- ClickUp (edit jobs) ---
# Required for real ClickUp task creation. If blank, local/dev uses a fake ClickUp client.
CLICKUP_API_TOKEN=

# --- Scheduling behavior ---
# How long to wait for a videographer to accept before escalating (hours)
ESCALATION_HOURS=24
# Scoring penalty: rating points deducted per minute of drive time
# Example: 0.01 means a 30-min drive penalizes 0.30 rating points
SCORE_PENALTY_PER_MINUTE=0.01
# Hard cap: skip any videographer further than this (minutes)
MAX_DRIVE_MINUTES=180

# --- Notifications (where to alert your friend) ---
NOTIFY_EMAIL=
